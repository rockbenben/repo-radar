{
  "name": "@repo-radar/desktop",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --external:electron --external:electron-updater --outdir=dist --out-extension:.js=.cjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
