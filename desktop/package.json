{
  "name": "@repo-radar/desktop",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
